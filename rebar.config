{minimum_otp_vsn, "27"}.

%% Generate partisan-flavoured copies of OTP's `gen_server', `gen_statem',
%% `supervisor', etc. from the INSTALLED OTP source BEFORE partisan's own
%% compile starts. The escript calls `partisan_gen_transform:generate_all/1',
%% which compiles the rewritten forms straight to `partisan_gen_*' BEAMs in
%% partisan's `ebin' (NOT `.erl' sources in `src' — pretty-printing to source
%% would mis-render auto-imported BIFs; see the escript header). This makes the
%% `partisan_gen_*' beams exist by the time any downstream dependency (plum_db,
%% bondy, …) starts compiling against them.
%%
%% A pre-compile hook is required because, when two direct deps of a
%% top-level project both depend on partisan, rebar3 may start the
%% second dep's compile before partisan's post-compile hook fires. See
%% `priv/generate_otp_sources.escript' for details.
{pre_hooks, [
    {compile, "escript priv/generate_otp_sources.escript"}
]}.

{deps, [
        %% Core dependencies
        {uuid, "2.0.5", {pkg, uuid_erl}},
        {types, "~> 0.1.8"},
        {opentelemetry_api, "1.2.1"},
        telemetry,
        %% Exponential backoff for partisan_retry's optional backoff mode.
        {backoff, "1.1.6"}
        %% Applications under test
        %% {hbbft, {git, "git://github.com/helium/erlang-hbbft", {branch, "master"}}}
        %% {riak_ensemble, {git, "git://github.com/cmeiklejohn/riak_ensemble", {branch, "partisan"}}},
        %% {paxoid, {git, "git://github.com/cmeiklejohn/paxoid", {branch, "partisan"}}},
        %% {lashup, {git, "git://github.com/cmeiklejohn/lashup", {branch, "partisan"}}},
        %% {hbbft, {git, "git://github.com/helium/erlang-hbbft", {branch, "master"}}},
        %% {zraft_lib, {git, "git://github.com/cmeiklejohn/zraft_lib", {branch, "master"}}}
       ]}.

{dialyzer, [
    {base_plt_apps, [
        kernel, stdlib, erts, sasl, eunit, syntax_tools, compiler, crypto,
        ssl, public_key, inets
    ]}
]}.
{xref_checks, [undefined_function_calls]}.
{xref_ignores, [
  eredis,
  {partisan_peer_discovery_agent, format_status, 2}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.
{cover_export_enabled, true}.
{covertool, [{coverdata_files, ["ct.coverdata"]}]}.

{eunit_opts, [verbose, {report,{eunit_surefire,[{dir,"."}]}}]}.


{erlfmt, [
    write,
    {print_width, 80},
    {exclude_files, []},
    {files, "{src,include,test,examples}/*.{hrl,erl}"}
]}.

{project_plugins, [
    rebar3_proper,
    rebar3_ex_doc,
    rebar3_hex,
    rebar3_hank,
    {erlfmt, "1.8.0"}
]}.

{shell, [
  {erl_opts, [warnings_as_errors]},
  {apps, [partisan]},
  {config, "config/sys.config"}
]}.


{relx, [
    {release, {partisan, "partisan"}, [
        %% Erlang
        sasl,
        crypto,
        inets,
        tools,
        runtime_tools,
        os_mon,
        debugger,
        %% Third-parties
        types,
        uuid,
        opentelemetry_api,
        telemetry,
        partisan
    ]},
    {dev_mode, false},
    {include_src, false},
    {include_erts, true},
    {extended_start_script, true},
    {overlay_vars, "config/vars.config"}
]}.

