# Copy this file to test/fly/.env (which is git-ignored) and fill it in.
# Do NOT commit test/fly/.env — it holds your private Fly.io account details.

# Your Fly.io organisation slug (the private account identifier).
#   find it with:  fly orgs list
FLY_ORG=personal

# Fly app that owns the ephemeral test Machines (created on first run).
FLY_APP=partisan-ci

# Region to run in (pick one near you).  see:  fly platform regions
FLY_REGION=lhr

# Machine size. partisan_SUITE's performance_test builds large clusters.
FLY_CPU_KIND=performance
FLY_CPUS=8
FLY_MEMORY=16384        # megabytes (16 GB)

# Optional: a Fly deploy token for non-interactive / CI use.
#   create with:  fly tokens create deploy -a partisan-ci
# For GitHub Actions set this as the FLY_API_TOKEN repo secret instead of here.
# FLY_API_TOKEN=
